# Copy to pinata_back/.env (the API reads .env from the folder it runs in or a parent).
# Variables already set in the environment win, so compose.yaml's DATABASE_URL is kept.
# Docker Compose PostgreSQL (port 5433). For your own PostgreSQL, point this at it instead.
DATABASE_URL=postgres://pinata:pinata@localhost:5433/pinata
BIND_ADDR=0.0.0.0:8080
SOLANA_RPC_URL=https://api.devnet.solana.com
FRONTEND_ORIGIN=http://localhost:3000
# true when served over HTTPS
COOKIE_SECURE=false
# seed: where the demo profiles' keypairs are kept (git-ignored)
DEMO_KEYS_DIR=keys/demo
# seed: wallet that owns the demo profile "samirdourado" (sign in with it to post as that profile)
DEMO_OWNER_WALLET=
